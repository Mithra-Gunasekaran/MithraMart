<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Mithra-mart</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #222;
        }

        .navbar {
            background: #4f46e5;
            color: white;
            padding: 18px 40px;
            font-size: 24px;
            font-weight: bold;
        }

        .hero {
            text-align: center;
            padding: 90px 20px;
        }

        .hero h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 18px;
            color: #666;
        }

        .button {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 28px;
            background: #4f46e5;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

        .status {
            margin: 30px auto;
            padding: 15px;
            max-width: 400px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }
    </style>
</head>

<body>

    <div class="navbar">
        🛒 Mithra-mart
    </div>

    <div class="hero">
        <h1>Welcome to Mithra-mart</h1>
        <p>Your multi-vendor shopping platform</p>

        <a href="#" class="button">Explore Products</a>

        <div class="status">
            ✅ Application is running successfully!
        </div>
    </div>

</body>
</html>